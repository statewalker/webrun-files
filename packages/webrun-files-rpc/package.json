{
  "name": "@statewalker/webrun-files-rpc",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "FilesApi over any RPC: streamed reads and writes as chunks kept and awaited by (streamId, chunkId)",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-files/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-files/tree/main/packages/webrun-files-rpc#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-files.git",
    "directory": "packages/webrun-files-rpc"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome lint src tests"
  },
  "dependencies": {
    "@statewalker/webrun-files": "workspace:^"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "workspace:^",
    "@statewalker/webrun-files-tests": "workspace:^",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
