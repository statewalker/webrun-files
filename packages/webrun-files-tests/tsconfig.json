{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    // Overridden, as in every other package: the inherited `paths` are written
    // relative to the repo root with no `baseUrl`, which TypeScript rejects
    // (TS5090) in any config that does not replace them. Resolution goes
    // through node_modules instead, so `tsc --noEmit` here checks this package
    // against the built types of `@statewalker/webrun-files`.
    "paths": {}
  },
  "include": ["src/**/*.ts"]
}
