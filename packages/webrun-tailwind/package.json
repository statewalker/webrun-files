{
  "name": "@statewalker/webrun-tailwind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build-only Tailwind CSS transform: a RegisteredTransform that generates the generic all-classes Tailwind stylesheet (v4) for a `tailwind-css` input and hands it to the shared CSS transform.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/webrun-files": "workspace:*",
    "@statewalker/webrun-modules": "workspace:*",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "workspace:*",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
