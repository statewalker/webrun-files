{
  "name": "@statewalker/webrun-files-sqlite",
  "version": "0.13.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "SQLite-backed FilesApi implementations",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-files/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-files/tree/main/packages/webrun-files-sqlite#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-files.git",
    "directory": "packages/webrun-files-sqlite"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc --emitDeclarationOnly --declaration && node ../../scripts/cjs-types.mjs",
    "test": "vitest run",
    "lint": "biome lint src tests",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@statewalker/db-api": "catalog:",
    "@statewalker/db-sqlite": "catalog:",
    "@statewalker/webrun-files": "workspace:^"
  },
  "devDependencies": {
    "@statewalker/db-sqlite-do": "catalog:",
    "@statewalker/db-sqlite-node": "catalog:",
    "@statewalker/webrun-files-tests": "workspace:^",
    "@types/node": "catalog:",
    "pako": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
